// Liar's dice, small: two players, alice and bob, each roll one three-sided
// die (faces 1, 2, 3) and see only their own. A 3 is wild: it counts as every
// face.
//
// There are six bids, in rising order:
//   bid1 "at least one die shows 1"     bid4 "both dice show 1"
//   bid2 "at least one die shows 2"     bid5 "both dice show 2"
//   bid3 "at least one die shows 3"     bid6 "both dice show 3"
// (a wild 3 counts toward any face, so with dice 3 and 1, bid4 is true).
//
// Alice moves first and the players alternate. On your move you either make
// a bid higher than the standing one, or `call` the standing bid a lie (not
// possible before any bid is made). After a call both dice are shown: if the
// standing bid is true the bidder wins, otherwise the caller wins. The winner
// gets +1 and the loser -1.
//
// You are shown your die and, for each bid, whether it has been made so far
// (said[0] is bid1, ..., said[5] is bid6). The standing bid is the highest
// one made; bids were made in turn, alice first.

world Dice3

horizon 7

state {
  die_a: int = 0;
  die_b: int = 0;
  cur: int = 0;       // the standing bid, 0 = none yet
  mover: int = 0;     // 0 alice, 1 bob
  said: int[6];
}

init {
  die_a = randint(1, 3);
  die_b = randint(1, 3);
}

step {
  let can: int[7];
  if cur > 0 { can[0] = 1; }
  for b in cur + 1..7 { can[b] = 1; }

  let a = 0;
  if mover == 0 {
    a = hunch alice([die_a, said[0], said[1], said[2], said[3], said[4], said[5]],
                    [call, bid1, bid2, bid3, bid4, bid5, bid6], can);
  } else {
    a = hunch bob([die_b, said[0], said[1], said[2], said[3], said[4], said[5]],
                  [call, bid1, bid2, bid3, bid4, bid5, bid6], can);
  }

  if a > 0 {
    cur = a;
    said[a - 1] = 1;
    mover = 1 - mover;
  } else {
    let q = 1 + floor((cur - 1) / 3);
    let f = cur - (q - 1) * 3;
    let count = 0;
    if die_a == f || die_a == 3 { count = count + 1; }
    if die_b == f || die_b == 3 { count = count + 1; }
    let win = 1;                  // to alice
    if count >= q { win = -1; }   // the bid was true: the caller loses
    if mover == 1 { win = -win; }
    reward(alice, win);
    reward(bob, -win);
    done();
  }
}
